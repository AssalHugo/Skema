# Copier en apps/web/.env.local (Next.js, drizzle-kit et scripts/ le lisent).
# Sur Vercel / Trigger.dev : mêmes noms dans les variables d'environnement du projet.
# Ne jamais committer de valeurs réelles.

# --- Base de données (Neon) -------------------------------------------------
# Neon → Connection details → chaîne « pooled » (…-pooler…), sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/skema?sslmode=require

# --- Stockage (Cloudflare R2) -----------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=skema
# Domaine personnalisé relié au bucket (lecture publique, egress gratuit)
R2_PUBLIC_BASE_URL=https://assets.example.com
# Facultatif : par défaut https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=

# --- Gemini (clé liée au projet GCP avec facturation = paid tier) -----------
GEMINI_API_KEY=
GEMINI_MODEL_QUALITY=gemini-4-hydrogen
# Promo −50 % jusqu'au 31/12/2026, puis passer à gemini-4-hydrogen
GEMINI_MODEL_BULK=gemini-3.8-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite

# --- YouTube Data API v3 (phase 4) ------------------------------------------
YOUTUBE_API_KEY=

# --- Google Cloud / worker Cloud Run ----------------------------------------
GOOGLE_CLOUD_PROJECT=
# URL du service Cloud Run gcp-worker (ex. https://gcp-worker-xxxx-ew.a.run.app)
GCP_WORKER_URL=
# Secret partagé envoyé dans l'en-tête X-Worker-Secret (openssl rand -hex 32)
GCP_WORKER_SECRET=

# --- TTS (appelé uniquement via gcp-worker /tts, auth par compte de service) -
TTS_VOICE=fr-FR-Neural2-F
# Une mark par mot affiché : l'interpolation (4) a échoué en S.3
TTS_MARK_EVERY=1
# none | wavenet | scribe
TTS_FALLBACK=none

# --- Extraction PDF ---------------------------------------------------------
# gemini (défaut) | mistral (repli si les seuils de S.2 échouent)
PDF_EXTRACTOR=gemini

# --- Orchestration (Trigger.dev) --------------------------------------------
TRIGGER_SECRET_KEY=
# Identifiant du projet Trigger.dev (proj_…), utilisé par trigger.config.ts
TRIGGER_PROJECT_REF=

# --- Authentification (Better Auth) -----------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL publique de l'app (http://localhost:3000 en local)
BETTER_AUTH_URL=http://localhost:3000
# Facultatif : connexion Google (OAuth client « Web » du projet GCP)
# Redirect URI : <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Budget -----------------------------------------------------------------
# Garde-fou applicatif (phase 5) : les tâches IA/TTS sont suspendues au-delà
MONTHLY_BUDGET_EUR=10

# --- Replis (facultatifs, désactivés par défaut) ----------------------------
MISTRAL_API_KEY=
ELEVENLABS_API_KEY=
